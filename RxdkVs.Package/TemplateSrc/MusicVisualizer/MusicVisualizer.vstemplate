<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="ProjectGroup" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Original Xbox Music Visualizer (Multi-Project)</Name>
    <Description>A D3D8 FFT equalizer that streams an Ogg Vorbis track, split into two projects: the visualizer executable plus a vorbis decoder static library it links via a project reference. Demonstrates the RXDK multi-project build with runtime media. Builds with the clean-room Zig toolchain.</Description>
    <Icon>__TemplateIcon.png</Icon>
    <ProjectType>VC</ProjectType>
    <SortOrder>1090</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>XboxMusic</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>xbox</PlatformTag>
    <ProjectTypeTag>games</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <ProjectCollection>
      <ProjectTemplateLink ProjectName="$safeprojectname$">parent\MyTemplate.vstemplate</ProjectTemplateLink>
      <ProjectTemplateLink ProjectName="vorbis">child\MyTemplate.vstemplate</ProjectTemplateLink>
    </ProjectCollection>
  </TemplateContent>
</VSTemplate>
