<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared MSBuild props for native RXDK Xbox projects (Makefile-type .vcxproj).

  Visual Studio owns the project system (Solution Explorer, IntelliSense, Build menu,
  Error List, F5), but the compile is delegated to Rxdk.Cli.exe, which runs the
  clean-room Zig pipeline against our own headers/libs. cl.exe does NOT compile the
  title (our libs are GNU-ABI and can't be linked by MSVC); it only powers the IDE.

  The .vcxproj is the single source of truth: VS owns the source list via @(ClCompile),
  and per-project settings are the Rxdk* properties below. Rxdk.Xbox.targets generates the
  build manifest into out\ from these; there is no hand-authored rxdk.project.json.

  A project sets: <NMakeOutput> (its .xbe/.lib/.dxt), and as needed <RxdkType>,
  <RxdkLibraries> (semicolon list), <RxdkPublicIncludePaths>, <RxdkDefines>, <RxdkStackSize>.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Marker so the RXDK VS extension recognizes this as an Xbox project and routes F5 /
         the green Run button to the Xbox debug adapter instead of the Local Windows Debugger. -->
    <RxdkXbox>true</RxdkXbox>

    <!-- Rxdk.Cli.exe: env override wins, else the published ProgramData engine dir. -->
    <RxdkCli Condition="'$(RXDK_TOOLS_DIR)' != ''">$(RXDK_TOOLS_DIR)\Rxdk.Cli.exe</RxdkCli>
    <RxdkCli Condition="'$(RxdkCli)' == ''">$(ProgramData)\RXDK\engine\Rxdk.Cli.exe</RxdkCli>

    <!-- Clean-room Zig SDK headers, for IntelliSense (the same dir the build compiles against). -->
    <RxdkSdkInclude>$(ProgramData)\RXDK\sdk\include</RxdkSdkInclude>

    <!-- Build flavor drives BOTH the SDK library variant (debug/release) and the optimize base.
         Defaults by config name (the Debug config is Debug-flavored, any other config - including
         a custom one like "my app" - is Release-flavored), but it's editable per-config on the
         Xbox Build page (RxdkBuildFlavor), so a custom config can be set to either. -->
    <RxdkBuildFlavor Condition="'$(RxdkBuildFlavor)' == '' and '$(Configuration)' == 'Debug'">Debug</RxdkBuildFlavor>
    <RxdkBuildFlavor Condition="'$(RxdkBuildFlavor)' == ''">Release</RxdkBuildFlavor>
    <!-- Debug flavor = -O0 -g; Release flavor = the mode chosen on the Xbox Build page
         (RxdkReleaseOptimize, default ReleaseFast). RxdkOptimize is passed to Rxdk.Cli. -->
    <RxdkReleaseOptimize Condition="'$(RxdkReleaseOptimize)' == ''">ReleaseFast</RxdkReleaseOptimize>
    <RxdkOptimize Condition="'$(RxdkBuildFlavor)' == 'Debug'">Debug</RxdkOptimize>
    <RxdkOptimize Condition="'$(RxdkOptimize)' == ''">$(RxdkReleaseOptimize)</RxdkOptimize>
    <!-- SDK library variant: debug libs for a Debug-flavored config, release libs otherwise. -->
    <RxdkConfig Condition="'$(RxdkBuildFlavor)' == 'Debug'">debug</RxdkConfig>
    <RxdkConfig Condition="'$(RxdkConfig)' == ''">release</RxdkConfig>

    <!-- Build-manifest defaults (a project overrides RxdkType/RxdkLibraries/etc. as needed). -->
    <RxdkType Condition="'$(RxdkType)' == ''">executable</RxdkType>
    <RxdkStackSize Condition="'$(RxdkStackSize)' == ''">65536</RxdkStackSize>
    <RxdkImageDebug Condition="'$(RxdkImageDebug)' == ''">true</RxdkImageDebug>
    <RxdkNoLogo Condition="'$(RxdkNoLogo)' == ''">true</RxdkNoLogo>
    <RxdkNoLibWarn Condition="'$(RxdkNoLibWarn)' == ''">true</RxdkNoLibWarn>
    <!-- imagebld toggles default off; set here (not just as rule Default=) so the Xbox Image
         property page shows their effective value instead of a blank cell. -->
    <RxdkLimitMemory Condition="'$(RxdkLimitMemory)' == ''">false</RxdkLimitMemory>
    <RxdkDontModifyHardDisk Condition="'$(RxdkDontModifyHardDisk)' == ''">false</RxdkDontModifyHardDisk>
    <RxdkDontMountUtilityDrive Condition="'$(RxdkDontMountUtilityDrive)' == ''">false</RxdkDontMountUtilityDrive>
    <RxdkFormatUtilityDrive Condition="'$(RxdkFormatUtilityDrive)' == ''">false</RxdkFormatUtilityDrive>
    <RxdkUtilityDriveClusterSize Condition="'$(RxdkUtilityDriveClusterSize)' == ''">0</RxdkUtilityDriveClusterSize>

    <!-- Deployment: pack an .iso via xdvdfs after the .xbe (set false to stop at the .xbe). -->
    <RxdkCreateIso Condition="'$(RxdkCreateIso)' == ''">true</RxdkCreateIso>

    <!-- Per-configuration output directory (out\Debug, out\Release, out\MyApp, ...) so builds of
         different configs don't overwrite each other. Overridable. Artifacts (obj/xbe/lib/iso)
         land here; the build manifest stays at the stable out\ path below so referenced library
         projects are always found regardless of the active configuration. -->
    <RxdkOutDir Condition="'$(RxdkOutDir)' == ''">out\$(Configuration)</RxdkOutDir>
    <!-- Surface the same location on the built-in General page ($(OutDir)/$(IntDir)). -->
    <OutDir>$(MSBuildProjectDirectory)\$(RxdkOutDir)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\$(RxdkOutDir)\</IntDir>

    <!-- Generated build manifest (stable out\ location, gitignored). -->
    <RxdkManifestFile>$(MSBuildProjectDirectory)\out\rxdk.manifest.json</RxdkManifestFile>
  </PropertyGroup>

  <!-- Makefile-project command lines + IntelliSense settings. The build reads the generated
       manifest that Rxdk.Xbox.targets writes into out\ before the build runs. -->
  <PropertyGroup>
    <NMakeBuildCommandLine>"$(RxdkCli)" build --project-root "$(MSBuildProjectDirectory)" --optimize $(RxdkOptimize) --manifest "$(RxdkManifestFile)"</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>"$(RxdkCli)" build --project-root "$(MSBuildProjectDirectory)" --optimize $(RxdkOptimize) --manifest "$(RxdkManifestFile)"</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>if exist "$(MSBuildProjectDirectory)\out" rmdir /S /Q "$(MSBuildProjectDirectory)\out"</NMakeCleanCommandLine>
    <NMakePreprocessorDefinitions>_XBOX;XBOX;$(RxdkDefines);$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
    <NMakeIncludeSearchPath>$(RxdkSdkInclude);$(RxdkIncludePaths);$(RxdkPublicIncludePaths);$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <!-- Match the build's `-include picolibc.h` so IntelliSense sees the libc baseline (NULL,
         size_t, …); without it those cascade into "unresolved" squiggles even though the Zig
         build (the source of truth) compiles fine. -->
    <!-- IntelliSense parses with the MSVC front-end, so give it the MSVC standard switch
         (/std:c++latest). The clang '-std=c++23' the real build uses is not understood here. -->
    <AdditionalOptions>/std:c++latest</AdditionalOptions>
  </PropertyGroup>

  <!-- Relabel the green Run button / debug-target dropdown to "Xbox Debugger (RXDK)".
       Contributed like VS's built-in debugger rules (no Context); DebuggerFlavor is
       forced unconditionally so it wins over the WindowsLocalDebugger default. F5 is
       still handled by the extension's Debug.Start interceptor. -->
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkDebugger.xml" />
  </ItemGroup>
  <PropertyGroup>
    <DebuggerFlavor>RxdkXboxDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!-- Every project reference is BUILD-ORDER-ONLY: a referenced library is a Makefile project
       VS can't consume as a linkable output (RXDK links it via the manifest instead), so default
       these off for ALL references - including ones a user adds through the VS "Add Reference" UI,
       so they never see the reference warning or have to hand-edit metadata. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>

  <!-- "Xbox Image" project property page: the imagebld settings that build the .xbe (like the
       original XDK's Xbox Image page). The Rxdk* properties it edits are read by
       Rxdk.Xbox.targets when it generates the build manifest. -->
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxBuild.xml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxImage.xml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxCertificate.xml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxTitleInfo.xml">
      <Context>Project</Context>
    </PropertyPageSchema>
  </ItemGroup>

  <!-- "Xbox Deployment" project property page: how media is collected (deployed + embedded
       files) and whether an .iso is packed. -->
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxDeployment.xml">
      <Context>Project</Context>
    </PropertyPageSchema>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)Rxdk.Xbox.targets" />
</Project>
