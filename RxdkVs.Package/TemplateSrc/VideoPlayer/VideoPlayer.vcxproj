<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{$guid1$}</ProjectGuid>
    <RootNamespace>XboxNamespace</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>$safeprojectname$</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="Rxdk.Xbox.props" />
  <PropertyGroup>
    <RxdkLibraries>libxapi;libd3d8;libdsound;libxmv;libc;libcpp;libkernel</RxdkLibraries>
    <!-- Copied next to default.xbe on deploy (streamed at runtime). -->
    <RxdkDeployPaths>media/test.xmv</RxdkDeployPaths>
    <!-- Baked into the XBE as a named section (path|name). -->
    <RxdkEmbed>media/dsstdfx.bin|dsstdfx</RxdkEmbed>
    <NMakeOutput>$(MSBuildProjectDirectory)\$(RxdkOutDir)\$(MSBuildProjectName).xbe</NMakeOutput>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="media\test.xmv" />
    <None Include="media\dsstdfx.bin" />
    <None Include="Rxdk.Xbox.props" />
    <None Include="Rxdk.Xbox.targets" />
    <None Include="RxdkDebugger.xml" />
    <None Include="RxdkXboxImage.xml" />
    <None Include="RxdkXboxBuild.xml" />
    <None Include="RxdkXboxDeployment.xml" />
    <None Include="RxdkXboxCertificate.xml" />
    <None Include="RxdkXboxTitleInfo.xml" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
