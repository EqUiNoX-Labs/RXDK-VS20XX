<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="ProjectGroup" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Original Xbox Cube (Multi-Project)</Name>
    <Description>A spinning textured cube split into two projects: the game executable plus a cubemesh static library it links via a project reference. Demonstrates the RXDK multi-project (projectReferences) build. Builds with the clean-room Zig toolchain.</Description>
    <Icon>__TemplateIcon.png</Icon>
    <ProjectType>VC</ProjectType>
    <SortOrder>1080</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>XboxCube</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>xbox</PlatformTag>
    <ProjectTypeTag>games</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <ProjectCollection>
      <ProjectTemplateLink ProjectName="$safeprojectname$">parent\MyTemplate.vstemplate</ProjectTemplateLink>
      <ProjectTemplateLink ProjectName="cubemesh">child\MyTemplate.vstemplate</ProjectTemplateLink>
    </ProjectCollection>
  </TemplateContent>
</VSTemplate>
