<?xml version="1.0" encoding="utf-8"?>
<!--
  "Certificate" project property page (mirrors the original XDK's Xbox Image > Certificate page).
  Sets the XBE certificate fields via imagebld /TEST* switches. Rxdk.Xbox.targets writes these
  Rxdk* properties into the build manifest; Rxdk.Cli passes them to imagebld.
  Per-configuration (grouped under Configuration Properties with Xbox Image); usually the same across configs.
-->
<Rule Name="RxdkXboxCertificate"
      DisplayName="Xbox Certificate"
      PageTemplate="generic"
      Description="XBE certificate fields (imagebld /TEST* switches)."
      Order="210"
      xmlns="http://schemas.microsoft.com/build/2009/properties">

  <Rule.Categories>
    <Category Name="Certificate" DisplayName="Certificate" Description="XBE certificate." />
  </Rule.Categories>

  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="true" />
  </Rule.DataSource>

  <StringProperty Name="RxdkTestId" DisplayName="Title ID"
                  Category="Certificate"
                  Description="XBE Title ID (imagebld /TESTID). Decimal or 0x-hex." />

  <StringProperty Name="RxdkTestAltId" DisplayName="Alternate ID"
                  Category="Certificate"
                  Description="Alternate title ID for access by alternate images (imagebld /TESTALTID). 'number' or 'number,key'." />

  <StringProperty Name="RxdkTestRegion" DisplayName="Xbox Game Region"
                  Category="Certificate"
                  Description="Allowed regions bitmask (imagebld /TESTREGION): 1=North America, 2=Japan, 4=Rest of World, 0x80000000=Manufacturing." />

  <StringProperty Name="RxdkTestRatings" DisplayName="Xbox Game Rating"
                  Category="Certificate"
                  Description="Ratings value (imagebld /TESTRATINGS)." />

  <StringProperty Name="RxdkTestMediaTypes" DisplayName="Media Types"
                  Category="Certificate"
                  Description="Allowed media types bitmask (imagebld /TESTMEDIATYPES)." />

  <StringProperty Name="RxdkTestLanKey" DisplayName="LAN Key"
                  Category="Certificate"
                  Description="LAN key for this image (imagebld /TESTLANKEY)." />

  <StringProperty Name="RxdkTestSignKey" DisplayName="Sign Key"
                  Category="Certificate"
                  Description="Signature key for this image (imagebld /TESTSIGNKEY)." />

</Rule>
