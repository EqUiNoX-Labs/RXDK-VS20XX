ps.1.1

tex         t0      ; Define t0 as a standard 3-vector.
texm3x3pad  t1, t0_bx2  ; Perform first row of matrix multiply.
texm3x3pad  t2, t0_bx2  ; Perform second row of matrix multiply.
texm3x3tex  t3, t0_bx2  ; Perform third row of matrix multiply, and use result to sample texture 3

mov r0.rgb, t3       ; Put specular color into the result.
+mov r0.a,  t0       ; Put diffuse color into the alpha channel
