<?xml version="1.0" encoding="utf-8"?>
<!--
  "Title Info" project property page (mirrors the original XDK's Xbox Image > Title Info page).
  Sets the XBE title name/version and title/save images via imagebld switches. File paths are
  project-relative and resolved by the engine. Per-configuration (grouped with Xbox Image).
-->
<Rule Name="RxdkXboxTitleInfo"
      DisplayName="Xbox Title Info"
      PageTemplate="generic"
      Description="XBE title name, version and images (imagebld switches)."
      Order="220"
      xmlns="http://schemas.microsoft.com/build/2009/properties">

  <Rule.Categories>
    <Category Name="TitleInfo" DisplayName="Title Info" Description="Title identity and images." />
  </Rule.Categories>

  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="true" />
  </Rule.DataSource>

  <StringProperty Name="RxdkTestName" DisplayName="Title Name"
                  Category="TitleInfo"
                  Description="Title name baked into the XBE certificate (imagebld /TESTNAME)." />

  <StringProperty Name="RxdkTestVersion" DisplayName="XBE Version"
                  Category="TitleInfo"
                  Description="Title version number (imagebld /TESTVERSION)." />

  <StringProperty Name="RxdkTitleInfo" DisplayName="Title Info File"
                  Subtype="file" Category="TitleInfo"
                  Description="Project-relative title info file (imagebld /TITLEINFO)." />

  <StringProperty Name="RxdkTitleImage" DisplayName="Title Image"
                  Subtype="file" Category="TitleInfo"
                  Description="Project-relative title image in XPR format (imagebld /TITLEIMAGE)." />

  <StringProperty Name="RxdkDefaultSaveImage" DisplayName="Save Game Image"
                  Subtype="file" Category="TitleInfo"
                  Description="Project-relative default save image in XPR format (imagebld /DEFAULTSAVEIMAGE)." />

</Rule>
