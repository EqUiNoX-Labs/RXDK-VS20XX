xps.1.1

;
; T0 = Color map
; T1 = Normal map
; T2 = Diffuse light vector
; T3 = Half angle vector
;

; default ambeint
def c0,0.1,0.1,0.1,1.0

tex t0
tex t1
tex t2
tex t3

xdd r0.rgb,r1.rgb,t1_bx2,t2_bx2,t1_bx2,t3_bx2			; r0 = N dot L and r1 = N dot H
+ mov r0.a,t0.a											; r0.a = t0.a

xmma discard.rgb,discard.rgb,r0.rgb,r0_sat,t0,c0,t0		; Modulate diffuse and ambient with color
+ mul r1.a,r1_sat.b,r1_sat.b							; ^2

mul r1.a,r1.a,r1.a										; ^4
mul r1.a,r1.a,r1.a										; ^8
mul r1.a,r1.a,r1.a										; ^16
mul r1.a,r1.a,r1.a										; ^32

add	r0.rgb,r0.rgb,r1.a									; Add specular
