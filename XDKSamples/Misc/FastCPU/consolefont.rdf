// List of resources to bundle.
//
// The output will be a header file (.h) used at compile time,
// and a packed resource file (.xpr) used at runtime.

out_header         ConsoleFont.h
out_packedresource Media\ConsoleFont.xpr
out_error          ConsoleFont.err


Texture Font
{
   Source      Media\Fonts\Courier_New_11.tga
   Format      D3DFMT_A4R4G4B4
   Levels      1
}

UserData FontData
{
   DataFile Media\Fonts\Courier_New_11.abc
}

