// List of resources to bundle.
//
// The output will be a header file (.h) used at compile time,
// and a packed resource file (.xpr) used at runtime.

out_packedresource Media\OnlineIconsFont.xpr
out_error          OnlineIconsFont.err


Texture Font
{
   Source      ..\..\Common\Media\Fonts\OnlineIcons.tga
   Format      D3DFMT_A4R4G4B4
   Levels      1
}

UserData FontData
{
   DataFile ..\..\Common\Media\Fonts\OnlineIcons.abc
}

