// List of resources to bundle.
//
// The output will be a header file (.h) used at compile time,
// and a packed resource file (.xpr) used at runtime.

out_packedresource Media\Font_jpn.xpr
out_error          Font_jpn.err


Texture Font
{
   Source      Media\Fonts\Font_jpn.tga
   Format      D3DFMT_A4R4G4B4
   Levels      1
}

UserData FontData
{
   DataFile Media\Fonts\Font_jpn.abc
}

