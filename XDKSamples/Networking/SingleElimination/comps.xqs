				<query hexid="0x10001" op="custom" name="Adjust Entrant Counts">
					<params>
						<param name="p_entrants" hexid="0x82010018" kind="int"/>
						<param name="p_private_entrants" hexid="0x82010019" kind="int"/>
						<param name="p_reg_close" hexid="0x82010002" kind="int"/>
						<param name="p_is_team_comp" hexid="0x82010010" kind="int"/>
					</params>
					<custom>
						<![CDATA[update t_query_dataset_ffff4005_1
set att_80010018 = att_80010018 + @att_82010018,
att_80010019 = att_80010019 + @att_82010019
where bi_entity_id = @bi_entity_id
    and (att_80010018 + @att_82010018) <= att_80010012     -- XONLINE_COMP_ATTR_PUBLIC_ENTRANTS <= XONLINE_COMP_ATTR_MAX_PUBLIC_SLOTS
    and (att_80010019 + @att_82010019) <= att_80010013     -- XONLINE_COMP_ATTR_PRIVATE_ENTRANTS <= XONLINE_COMP_ATTR_MAX_PRIVATE_SLOTS
    and att_80010002 >= @att_82010002                      -- XONLINE_COMP_ATTR_REG_CLOSE >= current time
    and (att_80010001-1799062968) <= @att_82010002         -- XONLINE_COMP_ATTR_REG_OPEN - (3 minutes) <= current time
    and att_8001001D =  0                                  -- XONLINE_COMP_ATTR_STATUS == XONLINE_COMP_STATUS_PRE_INIT
    and att_80010010 = @att_82010010                       -- XONLINE_COMP_ATTR_IS_TEAM_COMP == @XONLINE_COMP_ATTR_IS_TEAM_COMP
if (@@rowcount <> 1)
begin
  -- update failed, figure out why
  --
  if not exists (select * from t_query_dataset_ffff4005_1 where @bi_entity_id = @bi_entity_id)
      return 0x80156102                               -- XONLINE_E_QUERY_ENTITY_NOT_FOUND
  if not exists (select * from t_query_dataset_ffff4005_1
      where bi_entity_id = @bi_entity_id
          and att_8001001D <> 0xFFFFFFFF)               -- XONLINE_COMP_ATTR_STATUS == XONLINE_COMP_STATUS_ACTIVE
      return 0x80156206                               -- XONLINE_E_COMP_CANCELLED
  if not exists (select * from t_query_dataset_ffff4005_1
      where bi_entity_id = @bi_entity_id
          and att_80010010 = @att_82010010)             -- XONLINE_COMP_ATTR_IS_TEAM_COMP == @XONLINE_COMP_ATTR_IS_TEAM_COMP
      return 0x8015621A                               -- XONLINE_E_COMP_INVALID_ENTRANT_TYPE
  if not exists (select * from t_query_dataset_ffff4005_1
      where bi_entity_id = @bi_entity_id
          and att_80010002 >= @att_82010002             -- XONLINE_COMP_ATTR_REG_CLOSE >= current time
          and (att_80010001-1799062968) <= @att_82010002 -- XONLINE_COMP_ATTR_REG_OPEN - (3 minutes) <= current time
          and att_8001001D =  0)                        -- XONLINE_COMP_ATTR_STATUS == XONLINE_COMP_STATUS_PRE_INIT
      return 0x80156203                               -- XONLINE_E_COMP_REGISTRATION_CLOSED
  return 0x80156204                                   -- XONLINE_E_COMP_FULL
end
return 0x0
]]>
					</custom>
				</query>
				<query hexid="0x1000a" op="custom" name="Adjust Time Fields">
					<params>
						<param name="p_debug_adjust_time" hexid="0x82010023" kind="int"/>
					</params>
					<custom>
						<![CDATA[update t_query_dataset_ffff4005_1
set att_80010001 = att_80010001 + @att_82010023,        -- XONLINE_COMP_ATTR_REG_OPEN
    att_80010002 = att_80010002 + @att_82010023,        -- XONLINE_COMP_ATTR_REG_CLOSE
    att_80010003 = att_80010003 + @att_82010023,        -- XONLINE_COMP_ATTR_COMP_START
    att_8001000A = att_8001000A + @att_82010023,        -- XONLINE_COMP_ATTR_CURRENT_ROUND_START
    att_8001000B = att_8001000B + @att_82010023,        -- XONLINE_COMP_ATTR_CURRENT_ROUND_END
    att_8001000C = att_8001000C + @att_82010023,        -- XONLINE_COMP_ATTR_ROUND_ONE_START
    att_8001000D = att_8001000D + @att_82010023         -- XONLINE_COMP_ATTR_ROUND_ONE_END
where bi_entity_id = @bi_entity_id
if (@@rowcount <> 1)
begin
    -- update failed, figure out why
    --
    if not exists (select * from t_query_dataset_ffff4005_1 where @bi_entity_id = @bi_entity_id)
        return 0x80156102                               -- XONLINE_E_QUERY_ENTITY_NOT_FOUND
end
return 0x0
]]>
					</custom>
				</query>
